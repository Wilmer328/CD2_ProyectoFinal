# Copia este archivo como `.env` y rellena el valor. `.env` esta en .gitignore
# y no se sube nunca: la cadena de conexion da acceso total a la base.
#
# Donde sale: Supabase -> Project Settings -> Database -> Connection string
# -> pestaña URI, modo "Session pooler". Sustituye [YOUR-PASSWORD] por la
# contraseña que pusiste al crear el proyecto.
#
# Cada integrante del equipo tiene su propio .env con esta misma variable.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres
