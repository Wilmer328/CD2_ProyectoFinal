# Credenciales. NUNCA se versionan: la cadena de conexion a la base da acceso
# total al proyecto de Supabase.
.env
.env.*
!.env.ejemplo

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/

# Datos generados. Se reproducen con `python -m datos.generar` (semilla fija),
# asi que versionarlos solo engordaria el repositorio.
datos/procesados/*
!datos/procesados/.gitkeep
# Excepcion: el dataset analitico si se versiona (130 KB). Es lo que consume el
# dashboard, y sin el no se podria desplegar ni abrir la demo sin credenciales
# de Supabase.
!datos/procesados/dataset.parquet

# Modelos entrenados: normalmente no se versionan porque son artefactos de
# compilacion. Este si, por el mismo motivo que el dataset: el dashboard lo
# carga al arrancar y tiene que poder desplegarse solo con el repositorio.
modelos/*.pkl

# Streamlit
.streamlit/secrets.toml

# Sistema
.DS_Store
Thumbs.db
